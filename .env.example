BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DATA_DIR=./data
# Comma-separated user ids treated as admin even if role is still "user" (break-glass).
# Prefer UPDATE user SET role = 'admin' WHERE email = '…' after a normal signup.
ADMIN_USER_IDS=

MAILER_PROVIDER=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=Paris Ouverte <noreply@localhost>
RESEND_API_KEY=
# Inbox for public contact form notifications (Mailpit locally, real address in production).
CONTACT_TO=hello@localhost

# Observability (optional; empty = disabled)
# Sentry — Server uses SENTRY_DSN. Client also needs NEXT_PUBLIC_SENTRY_DSN (same value).
# Optional build-time source maps: SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# New Relic — Server APM only. App name defaults to paris-ouverte.
NEW_RELIC_LICENSE_KEY=
# healthchecks.io — Ping URL for the Vélib’ alerts cron dead-man's switch.
HEALTHCHECKS_PING_URL=
